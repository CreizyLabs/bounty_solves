/-! ## Section 3: Main Theorems (JSP-000746) -/

private theorem refCtx_false (ctx : RefCtx) : False :=
  r1837 ctx

private lemma no_triangle_of_cliqueFree {V : Type*} {G : SimpleGraph V}
    (hG : G.CliqueFree 3) {a b c : V} (hab : G.Adj a b) (hbc : G.Adj b c) (hac : G.Adj a c) :
    False := by
  classical
  have h1 : a ≠ b := G.ne_of_adj hab
  have h2 : a ≠ c := G.ne_of_adj hac
  have h3 : b ≠ c := G.ne_of_adj hbc
  apply hG {a, b, c}
  refine ⟨?_, ?_⟩
  · intro x hx y hy hxy
    simp only [Finset.mem_coe, Finset.mem_insert, Finset.mem_singleton] at hx hy
    rcases hx with rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl
    · exact absurd rfl hxy
    · exact hab
    · exact hac
    · exact hab.symm
    · exact absurd rfl hxy
    · exact hbc
    · exact hac.symm
    · exact hbc.symm
    · exact absurd rfl hxy
  · rw [Finset.card_insert_of_notMem, Finset.card_pair h3]
    simp [h1, h2]

/-- **Sharp Finite Theorem (JSP-000746 on `{1, ..., 18}`):**
Every triangle-free simple graph on `Fin 18` (vertices indexed `0..17` representing `1..18`)
contains three vertices `x < y < z` with `(x.1 + 1) + (y.1 + 1) = z.1 + 1` that are pairwise
non-adjacent. -/
theorem jsp_000746_fin18 (G : SimpleGraph (Fin 18)) (hG : G.CliqueFree 3) :
    ∃ x y z : Fin 18, x < y ∧ (x.1 + 1) + (y.1 + 1) = z.1 + 1 ∧
      ¬ G.Adj x y ∧ ¬ G.Adj x z ∧ ¬ G.Adj y z := by
  by_contra hno
  push Not at hno
  exact refCtx_false ⟨G.Adj,
    fun _ _ hab hbc hac => no_triangle_of_cliqueFree hG hab hbc hac,
    fun hxy hsum h1 h2 h3 => h3 (hno _ _ _ hxy hsum h1 h2)⟩

/-- **Main Theorem on `ℕ` (JSP-000746):**
Every triangle-free simple graph on `ℕ` contains three distinct positive integers `x, y, x + y`
(`1 ≤ x < y`, `x + y ≤ 18`) forming an independent set. -/
theorem jsp_000746_nat (G : SimpleGraph ℕ) (hG : G.CliqueFree 3) :
    ∃ x y : ℕ, 0 < x ∧ x < y ∧ x + y ≤ 18 ∧
      ¬ G.Adj x y ∧ ¬ G.Adj x (x + y) ∧ ¬ G.Adj y (x + y) := by
  let f : Fin 18 ↪ ℕ := ⟨fun i => i.1 + 1, fun i j h => Fin.ext (Nat.succ.inj h)⟩
  let G18 : SimpleGraph (Fin 18) := G.comap f
  have hG18 : G18.CliqueFree 3 := by
    intro s hs
    apply hG (s.map f)
    refine ⟨?_, by rw [Finset.card_map]; exact hs.2⟩
    intro u hu v hv huv
    simp only [Finset.coe_map, Set.mem_image, Finset.mem_coe] at hu hv
    obtain ⟨a, ha, rfl⟩ := hu
    obtain ⟨b, hb, rfl⟩ := hv
    have hab : a ≠ b := fun h => huv (congrArg f h)
    exact hs.1 ha hb hab
  obtain ⟨x, y, z, hxy, hsum, h1, h2, h3⟩ := jsp_000746_fin18 G18 hG18
  refine ⟨x.1 + 1, y.1 + 1, Nat.succ_pos _, Nat.succ_lt_succ hxy, ?_, h1, ?_, ?_⟩
  · have hz := z.2; omega
  · rw [hsum]; exact h2
  · rw [hsum]; exact h3

/-- **Main Theorem on `ℤ` (JSP-000746):**
Every triangle-free simple graph on the integers `ℤ` contains three distinct independent vertices
`a, b, c : ℤ` with `a + b = c` (in fact `0 < a < b < c ≤ 18`). -/
theorem jsp_000746_int (G : SimpleGraph ℤ) (hG : G.CliqueFree 3) :
    ∃ a b c : ℤ, a ≠ b ∧ a ≠ c ∧ b ≠ c ∧ a + b = c ∧
      ¬ G.Adj a b ∧ ¬ G.Adj a c ∧ ¬ G.Adj b c := by
  let f : ℕ ↪ ℤ := ⟨Int.ofNat, fun _ _ h => Int.ofNat.inj h⟩
  let GN : SimpleGraph ℕ := G.comap f
  have hGN : GN.CliqueFree 3 := by
    intro s hs
    apply hG (s.map f)
    refine ⟨?_, by rw [Finset.card_map]; exact hs.2⟩
    intro u hu v hv huv
    simp only [Finset.coe_map, Set.mem_image, Finset.mem_coe] at hu hv
    obtain ⟨a, ha, rfl⟩ := hu
    obtain ⟨b, hb, rfl⟩ := hv
    have hab : a ≠ b := fun h => huv (congrArg f h)
    exact hs.1 ha hb hab
  obtain ⟨x, y, hx, hxy, _, h1, h2, h3⟩ := jsp_000746_nat GN hGN
  refine ⟨(x : ℤ), (y : ℤ), ((x + y : ℕ) : ℤ), ?_, ?_, ?_, by push_cast; rfl, h1, h2, h3⟩
  · omega
  · omega
  · omega

end JSP_000746

